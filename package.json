{
  "name": "pi-undo-tree",
  "version": "0.1.0",
  "description": "Emacs-style visual undo-tree for the Pi coding agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "undo-tree",
    "tui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}

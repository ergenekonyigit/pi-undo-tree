{
  "name": "pi-undo-tree",
  "version": "1.0.0",
  "description": "Emacs-style visual undo-tree for the Pi coding agent",
  "author": "Ergenekon Yiğit",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergenekonyigit/pi-undo-tree.git"
  },
  "homepage": "https://github.com/ergenekonyigit/pi-undo-tree#readme",
  "bugs": {
    "url": "https://github.com/ergenekonyigit/pi-undo-tree/issues"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "index.ts",
    "README.md",
    "LICENSE",
    "demo.gif",
    "catalog-preview.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "undo-tree",
    "session-branching",
    "tui"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "typecheck": "npm run check",
    "test": "npm run check && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://cdn.jsdelivr.net/npm/pi-undo-tree@1.0.0/catalog-preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.13.9",
    "typescript": "5.9.3",
    "vitest": "3.0.7"
  }
}
